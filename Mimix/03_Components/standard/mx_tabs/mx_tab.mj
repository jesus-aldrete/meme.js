class {
/*/ ***** Funciones ***** /*/
	// front-public
	Clone( element ) {
		if ( !element || element.tagName!=='MX-TAB' ) return;

		const pos = element.Position( 'off' );

		this.active     = element.active;
		this.style.top  = `${pos.top}px`;
		this.style.left = `${pos.left}px`;
	}

/*/ ***** Front ***** /*/
	// front-public
	View () {
		*cont>{this.body}
		mx_button.icon (click)=onClose>[mx_svg icon=regular:x]
	}
	Style() {/* Tema */
		@theme-light
			--back  : $!back|#e8e8e8
			--border: $!soft_75|#979797
			--color : $!back_10|#2e2e2e
			--after-back: $!back|#e8e8e8
			--hover-back      : $!soft_85|#c0c0c0
			--hover_after-back: $!soft_85|#c0c0c0
			--_active-back      : $!soft_85|#c0c0c0
			--_active_after-back: $!soft_85|#c0c0c0
			--_ghost-back: $!soft_85|#c0c0c0
		@theme-dark
			--back  : $!back_10|#2e2e2e
			--border: $!soft_60|#585858
			--color : $!back_40|#bababa
			--after-back: $!back_10|#2e2e2e
			--hover-back      : $!soft_30|#1c1c1c
			--hover_after-back: $!soft_30|#1c1c1c
			--_active-back      : $!soft_30|#1c1c1c
			--_active_after-back: $!soft_30|#1c1c1c
			--_ghost-back: $!soft_30|#1c1c1c
	}
	Style() {
		align-items     : center
		background-color: $back
		border          : 1 solid $border
		border-radius   : 8 8 0 0
		color           : $color
		cursor          : pointer
		display         : flex
		gap             : 5
		outline         : none
		padding         : 10 10 5 20
		position        : relative
		user-select     : none
		::after
			background-color: $after-back
			bottom          : 0
			content         : ''
			height          : 1
			left            : 0
			position        : absolute
			transform       : translateY(100%)
			width           : 100%
		::hover
			background-color: $hover-back
			::after
				background-color: $hover_after-back
		>*
			pointer-events: none
		>.icon
			visibility: hidden
			.mx_svg, svg
				height: 15
				width : 15
		>.cont
			align-items: center
			display    : flex
			gap        : 5
			.mx_svg
				height: 20
				width : 20
	}
	Style() {/* Estados */
		&._active
			background-color: $_active-back
			::after
				background-color: $_active_after-back
				height          : 2
			>.icon
				pointer-events: all
				visibility    : visible

		&._ghost
			background-color: $_ghost-back
			left            : 0
			position        : absolute
			top             : 0
			z-index         : 2
	}

	// front-public
	get cont() { return refs.cont }

	get order(     ) { return props.order }
	set order( val ) {
		val         =
		props.order = parseInt( val ) || 0;

		this.Css( 'order', val );
	}

	get value(     ) { return props.value ?? '' }
	set value( val ) { props.value = val }

	get active(     ) { return !!props.active }
	set active( val ) {
		props.active = typeof val==='string' ? !( !val || val.match( /false/i ) ) : !!val;

		if ( props.active )
		for ( const child of this.parentNode.childs ) {
			if ( child==this ) continue;

			child.active = false;
		}

		this.Class  ( '_active', props.active             );
		this.Trigger( 'change' , props.active, this.value );
	}

	// front-private
	onClose( event ) {
		event.stopPropagation();

		this.Trigger( 'close' );
	}
}