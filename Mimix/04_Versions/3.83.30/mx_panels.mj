class {
/*/ ***** View ***** /*/
	View () {
		*panels (open)=onOpen (mousedown)=onDown>{this.body}
	}
	Style() {
		@theme-light
			--border: $!soft_75|#979797
		@theme-dark
			--border: $!soft_60|#585858

		border        : solid 1 $border
		box-sizing    : border-box
		display       : flex
		flex-direction: column
		>.panels
			display       : flex
			flex          : 1
			flex-direction: column
			position      : relative
	}

	// front-public
	Create() {
		props.min_height??= 150;

		ResizePanels();
	}

/*/ ***** Front ***** /*/
	// front-public
	ResizePanels() {
		let   isr     = false;
		let   close_h = 0;
		const total   = refs.panels.Position().height;
		const opens   = [];

		if ( !total ) return;

		for ( const child of refs.panels.childs ) {
			if ( child.open ) {
				opens.push( child );

				!isr && (isr=!child.h);
			}
			else {
				child.h = null;
				close_h+= child.Position().height;
			}
		}

		if ( !isr || !opens.length ) return;

		let size = ( total - close_h ) / opens.length;

		for ( const child of opens ) {
			child.h            = size;
			child.style.height = size + 'px';
		}

		SetLast();
	}

	// front-private
	InitDrop  ( event, panel, drop ) {
		props.panel  = panel;
		drop.pageS   = event.pageY;
		drop.screenY = event.screenY;
		drop.start   = event.pageY - panel.Position().height;
		drop.opens   = [];

		for ( const panel of refs.panels.childs ) {
			if ( panel.open ) {
				panel.height     = panel.Position().height;
				panel.diference  = panel.height - props.min_height;
				panel.index      = drop.opens.length;
				panel.max_top    = panel.height + drop.opens.reduce( ( r, v ) => r + v.diference, 0 );

				drop.opens.push( panel );
			}
			else panel.style.height = '';
		}

		for ( let i=0; i<drop.opens.length; i++ ) {
			const panel      = drop.opens[i];
			panel.max_bottom = panel.height;

			for ( let ii=i+1; ii<drop.opens.length; ii++ ) panel.max_bottom+= drop.opens[ii].diference;
		}
	}
	SearchNext( panel, include_min ) {
		let nex, isa, iss;

		for ( let i=0; i<refs.panels.childs.length; i++ ) {
			const child = refs.panels.childs[i];

			if      ( child==panel                                                              ) isa = true;
			else if ( child.open && ( include_min || child.Position().height>props.min_height ) ) {
				if ( isa ) {
					if ( !iss ) {
						iss = true;
						nex = child;
					}
				}
				else if ( !iss ) nex = child;
			}
		}

		return nex;
	}
	SetLast   (                    ) {
		let ya = false;

		for ( let i=refs.panels.childs.length; i--; ) {
			const child = refs.panels.childs[i];

			child.Class( '_last', false );

			if ( !ya && child.open ) {
				ya = true;

				child.Class( '_last', true );
			}
		}
	}

/*/ ***** Eventos ***** /*/
	// front-private
	onOpen( _, value ) {
		const panel  = event.target.closest( 'mx-panels-panel' );
		const total  = refs.panels.Position().height;
		const childs = refs.panels.childs;

		if ( value ) {
			panel.h          ??= props.min_height;
			panel.style.height = panel.h + 'px';
		}
		else {
			panel.style.height = '';
		}

		let total_h = childs.reduce( ( r, v ) => r+v.Position().height, 0 );

		while ( total_h!=total ) {
			let next = SearchNext( panel );

			if ( total_h>total ) {
				if ( next ) {
					let re = total_h - total;
					let nh = next.Position().height - re;

					if ( nh<props.min_height ) nh = props.min_height;

					next.style.height = nh + 'px';
				}
				else if ( panel.open ) {
					panel.style.height = ( panel.Position().height + ( total - total_h ) ) + 'px';
				}
				else throw new Error( 'caso no considerado' );
			}
			else if ( total_h<total ) {
				if ( !next ) next = SearchNext( panel, true );

				if      ( next       ) next .style.height = ( next .Position().height + ( total - total_h ) ) + 'px';
				else if ( panel.open ) panel.style.height = ( panel.Position().height + ( total - total_h ) ) + 'px';
				else                   break;
			}

			total_h = childs.reduce( ( r, v ) => r+v.Position().height, 0 );
		}

		for ( const child of childs ) {
			child.open && (child.h=child.Position().height);
		}

		SetLast();
	}

	onDown( event ) {
		const panel  = event.target.closest( 'mx-panels-panel' );
		const target = event.target;

		if ( target.tagName!=='HR' || !panel       ) return;
		if ( panel.Class( '_last' ) || !panel.open ) return;

		event.preventDefault();

		InitDrop( event, panel, props.drop={} );

		/* Estado */
		props.cursor               = document.body.style.cursor;
		document.body.style.cursor = 'row-resize';

		panel.Class( '_is_drop', true );

		document.addEventListener( 'mousemove', onMove );
		document.addEventListener( 'mouseup'  , onUp   );
	}
	onMove( event ) {
		const { drop, panel, min_height }  = props;
		const diference                    = event.screenY - drop.screenY;
		let   hei                          = panel.height + diference;

		if ( hei<min_height       ) hei = min_height;
		if ( hei>panel.max_bottom ) hei = panel.max_bottom;

		panel.style.height = hei + 'px';

		const next = drop.opens[panel.index+1];
		let   he2  = next.height - diference;

		if ( he2<min_height   ) he2 = min_height;
		if ( he2>next.max_top ) he2 = next.max_top;

		next.style.height = he2 + 'px';

		if      ( event.pageY<drop.pageS ) {
			if ( drop.change_direction_bottom!=null ) {
				drop.change_direction_bottom = null;
				const dif                    = panel.Position().height - panel.height;

				if ( dif===diference ) InitDrop( event, panel, drop );
				else                   drop.change_direction_bottom_dif = dif;
			}

			if ( drop.change_direction_bottom_dif!=null && diference<=drop.change_direction_bottom_dif ) {
				drop.change_direction_bottom_dif = null;

				InitDrop( event, panel, drop );
			}

			if ( hei<=min_height ) {
				let push, mins = panel.diference;

				for ( let i=panel.index; i--; ) {
					const child = drop.opens[i];

					if ( child.Position().height<=min_height ) mins+= child.diference;
					else                                       { push = child; break }
				}

				if ( push ) {
					let hei = push.height + diference + mins;

					if ( hei<min_height ) hei = min_height;

					push.style.height         = hei + 'px';
					drop.change_direction_top = true;
				}
			}
		}
		else if ( event.pageY>drop.pageS ) {
			if ( drop.change_direction_top!=null ) {
				drop.change_direction_top = null;
				const dif                 = next.height - next.Position().height;

				if ( dif===diference ) InitDrop( event, panel, drop );
				else                   panel.height = min_height - ( drop.change_direction_top_dif=dif );
			}

			if ( drop.change_direction_top_dif!=null && diference>=drop.change_direction_top_dif ) {
				drop.change_direction_top_dif = null;

				InitDrop( event, panel, drop );
			}

			if ( he2<=min_height ) {
				let push, mins = 0;

				for ( let i=panel.index + 1; i<drop.opens.length; i++ ) {
					const child = drop.opens[i];

					if ( child.Position().height<=min_height ) mins+= child.diference;
					else                                       { push = child; break }
				}

				if ( push ) {
					let hei = push.height - diference + mins;

					if ( hei<min_height ) hei = min_height;

					push.style.height            = hei + 'px';
					drop.change_direction_bottom = true;
				}
			}
		}

		drop.pageS = event.pageY;
	}
	onUp  ( event ) {
		document.body.style.cursor = props.cursor;

		props.panel.Class( '_is_drop', false );

		document.removeEventListener( 'mousemove', onMove );
		document.removeEventListener( 'mouseup'  , onUp   );

		for ( const child of refs.panels.childs ) {
			if ( child.open ) {
				child.h = child.Position().height;
			}
		}
	}
}